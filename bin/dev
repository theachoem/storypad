#!/bin/bash

# Use this [bin/dev] to run Flutter project in specific flavor.
#
# Commands:
# bin/dev --community
# bin/dev --storypad
# bin/dev --spooky
#
# bin/dev --community-ios
# bin/dev --storypad-ios
# bin/dev --spooky-ios
#
# bin/dev --community-macos
# bin/dev --storypad-macos
# bin/dev --spooky-macos
#
# Works without the private_keys/ submodule checked out (e.g. external contributors
# who only cloned this repo) - see sync_private_keys / get_debug_keystore_path in
# bin/helpers. `community` is the only flavor with public Firebase config, so it's the
# only one that fully runs this way; storypad/spooky still need private_keys/.

source "$(dirname "$0")/helpers"

INPUT=$1
FLAVOR=$(echo "$INPUT" | sed -E 's/--([a-z]+)(-ios|-macos)?/\1/')

sync_private_keys

BASE_ARG="--target=lib/main_${FLAVOR}.dart --flavor $FLAVOR --dart-define-from-file=bin/.tmp/private_keys/dart_defines/${FLAVOR}.json"

# Export keystore paths: android/app/build.gradle.kts:80
# Skipped when private_keys/ isn't checked out - build.gradle.kts then falls back to
# the Android Gradle Plugin's own auto-generated debug keystore.
DEBUG_KEYSTORE_PATH=$(get_debug_keystore_path $FLAVOR)
if [ -n "$DEBUG_KEYSTORE_PATH" ]; then
  export DEBUG_KEYSTORE_PATH
  export DEBUG_KEYSTORE_PASSWORD="android"
  export DEBUG_KEY_PASSWORD="android"
  export DEBUG_KEY_ALIAS="androiddebugkey"
fi

case "$INPUT" in
--storypad)
  CMD="flutter run $BASE_ARG"
  ;;
--spooky)
  CMD="flutter run $BASE_ARG"
  ;;
--community | "")
  CMD="flutter run $BASE_ARG"
  ;;
--storypad-ios)
  CMD="flutter run $BASE_ARG --dart-define=CUPERTINO=yes"
  ;;
--storypad-macos)
  CMD="flutter run $BASE_ARG --dart-define=CUPERTINO=yes -d macos"
  ;;
--spooky-ios)
  CMD="flutter run $BASE_ARG --dart-define=CUPERTINO=yes"
  ;;
--community-ios | "")
  CMD="flutter run $BASE_ARG --dart-define=CUPERTINO=yes"
  ;;
--community-macos | "")
  CMD="flutter run $BASE_ARG --dart-define=CUPERTINO=yes -d macos"
  ;;
*)
  echo "Invalid option: $FLAVOR"
  echo "Usage: bin/dev [--storypad | --spooky | --community]"
  exit 1
  ;;
esac

# Remove 1st args
shift

echo "Executing: $CMD $1"
eval $CMD $1
