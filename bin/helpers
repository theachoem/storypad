#!/bin/bash

# A helper function to execute a command and echo it
function run_command() {
  sensitive_params=("DEVELOPER_MODE_PASSWORD" "FB_CLIENT_TOKEN" "CLIENT_ID" "CLIENT_SECRET")
  local masked_command="$1"

  # Mask each sensitive parameter
  # Replace occurrences like PARAM=... with PARAM=********
  for param in "${sensitive_params[@]}"; do
    masked_command=$(echo "$masked_command" | sed -E "s/($param)=([^[:space:]]+)/\1=********/g")
  done

  echo -e "[EXECUTING] $masked_command\n"
  eval "$(echo "$1" | tr -d '\n')"

  echo ""
}

function get_package_name() {
  case "$1" in
    storypad) echo "com.tc.writestory" ;;
    community) echo "com.tc.writestory.community" ;;
    *) echo "❌ Invalid flavor: $1" >&2; exit 1 ;;
  esac
}

# Validate flavor inputs
function validate_flavor_inputs() {
  COMMAND=$0
  FLAVOR=$1

  if [ "$FLAVOR" != "--storypad" ] && [ "$FLAVOR" != "--community" ]; then
    echo "❌ Error: Invalid environment specified: $FLAVOR"
    echo "Usage: $COMMAND [--storypad | --community]"
    exit 1
  fi
}

# Usage: get_provision_source_path FLAVOR [ios|macos]  (defaults to ios)
function get_provision_source_path() {
  FLAVOR=$1
  PLATFORM=${2:-ios}

  case "$PLATFORM" in
    ios)
      case "$FLAVOR" in
        storypad) echo "bin/.tmp/private_keys/ios_mobileprovision/StoryPad_IOS.mobileprovision" ;;
        community) echo "bin/.tmp/private_keys/ios_mobileprovision/Community_IOS.mobileprovision" ;;
        *) echo "❌ Invalid flavor: $FLAVOR" >&2; exit 1 ;;
      esac
      ;;
    macos)
      case "$FLAVOR" in
        storypad) echo "bin/.tmp/private_keys/ios_mobileprovision/StoryPad_MacOS.provisionprofile" ;;
        community) echo "bin/.tmp/private_keys/ios_mobileprovision/Community_MacOS.provisionprofile" ;;
        *) echo "❌ Invalid flavor: $FLAVOR" >&2; exit 1 ;;
      esac
      ;;
    *) echo "❌ Invalid platform: $PLATFORM" >&2; exit 1 ;;
  esac
}

# Usage: get_provision_export_path FLAVOR [ios|macos]  (defaults to ios)
function get_provision_export_path() {
  FLAVOR=$1
  PLATFORM=${2:-ios}

  echo "bin/.tmp/$PLATFORM/export_options/$FLAVOR.plist"
}

function setup_signing_certificates() {
  run_command "keychain initialize"
  run_command "keychain add-certificates
    --certificate bin/.tmp/private_keys/ios_certificates/ios_signing_certificate.p12
    --certificate-password $(get_env_key 'APPLE_CERTIFICATE_PASSWORD')"
}

# Xcode automatically loads provisioning profiles from ~/Library/MobileDevice/Provisioning Profiles
# To make Xcode recognize our repo's profile, we copy it into that folder.
# The file must be named with its UUID, otherwise Xcode won't detect it.
# Usage: copy_provisioning_profile_to_xcode_home FLAVOR [ios|macos]  (defaults to ios)
function copy_provisioning_profile_to_xcode_home() {
  FLAVOR=$1
  PLATFORM=${2:-ios}

  PROVISION_SOURCE_PATH=$(get_provision_source_path $FLAVOR $PLATFORM)
  EXTENSION="${PROVISION_SOURCE_PATH##*.}"
  DEST_DIR=$HOME/Library/MobileDevice/Provisioning\ Profiles

  # Extract UUID from the profile
  UUID=$(/usr/libexec/PlistBuddy -c 'Print :UUID' /dev/stdin <<< \
    $(security cms -D -i "$PROVISION_SOURCE_PATH"))

  mkdir -p "$DEST_DIR"

  # Clean up any invalid or corrupted provisioning profiles (both iOS and macOS ones)
  find "$DEST_DIR" \( -name "*.mobileprovision" -o -name "*.provisionprofile" \) -type f | while read -r profile; do
    # Try to read the profile, if it fails, it's corrupted
    if ! security cms -D -i "$profile" &>/dev/null; then
      echo "🗑️  Removing corrupted profile: $(basename "$profile")"
      rm -f "$profile"
    fi
  done

  cp "$PROVISION_SOURCE_PATH" "$DEST_DIR/$UUID.$EXTENSION"

  echo "✨ Installed provisioning profile: $UUID.$EXTENSION"
  echo ""
}

# Usage: install_provisioning_profile FLAVOR [ios|macos] PROJECT_PATH
# PROJECT_PATH is scoped explicitly (e.g. ios/Runner.xcodeproj) so this only
# touches the intended platform's Xcode project, not every *.xcodeproj in the repo.
function install_provisioning_profile() {
  FLAVOR=$1
  PLATFORM=${2:-ios}
  PROJECT_PATH=$3

  PROVISIONING_EXPORT_PATH=$(get_provision_export_path $FLAVOR $PLATFORM)

  mkdir -p $(dirname $PROVISIONING_EXPORT_PATH)

  run_command "xcode-project use-profiles \
    --project=$PROJECT_PATH \
    --export-options-plist=$PROVISIONING_EXPORT_PATH \
    --code-signing-setup-verbose-logging"

  cat $PROVISIONING_EXPORT_PATH
  echo ""
}

# Usage: get_env_key KEY_NAME
function get_env_key() {
  grep "^$1=" bin/.tmp/private_keys/.env | cut -d'=' -f2
}

# Mirrors the private_keys/ submodule (monorepo root, one level above app/) into
# bin/.tmp/private_keys/, so every script here reads from ONE consistent path
# regardless of flavor or whether private_keys/ is actually checked out. Call this
# before referencing anything under bin/.tmp/private_keys/. Additive only - re-syncing
# never deletes files already staged here, so generating community's fallback below
# never gets clobbered by a later sync for another flavor, and vice versa.
#
# - private_keys/ checked out (team members): copies its real contents in, so every
#   flavor gets real secrets.
# - private_keys/ missing (e.g. external contributors who only cloned this repo):
#   ensures `community`'s one required file (dart_defines/community.json) exists as an
#   empty fallback, so optional integrations (RevenueCat, Maps, Google Sign-In, ...)
#   just no-op instead of failing the build. storypad still needs the real submodule -
#   it has no public Firebase config to fall back to.
function sync_private_keys() {
  DEST="bin/.tmp/private_keys"
  mkdir -p "$DEST/dart_defines"

  if [ -d "../private_keys" ]; then
    cp -R ../private_keys/. "$DEST/"
    rm -rf "$DEST/.git"
  fi

  if [ ! -f "$DEST/dart_defines/community.json" ]; then
    echo '{}' > "$DEST/dart_defines/community.json"
  fi

  sync_app_store_connect_auth_keys
}

# xcrun altool/notarytool only look for AuthKey_*.p8 files in a fixed set of
# locations (cwd/private_keys, ~/private_keys, ~/.private_keys,
# ~/.appstoreconnect/private_keys) - bin/.tmp/private_keys isn't one of them.
# Mirror the keys into Apple's documented standard location so uploads keep
# working regardless of where private_keys/ is checked out in the repo.
function sync_app_store_connect_auth_keys() {
  DEST_KEYS_DIR="$HOME/.appstoreconnect/private_keys"
  shopt -s nullglob
  AUTH_KEYS=(bin/.tmp/private_keys/AuthKey_*.p8)
  shopt -u nullglob

  if [ ${#AUTH_KEYS[@]} -gt 0 ]; then
    mkdir -p "$DEST_KEYS_DIR"
    cp "${AUTH_KEYS[@]}" "$DEST_KEYS_DIR/"
  fi
}

# Echoes DEBUG_KEYSTORE_PATH (as android/app/build.gradle.kts needs it, relative to
# android/app/) if FLAVOR's debug keystore was staged by sync_private_keys; empty
# otherwise so callers skip exporting it and let the Android Gradle Plugin fall back to
# its own auto-generated ~/.android/debug.keystore (same store/key password convention:
# "android" / "androiddebugkey").
function get_debug_keystore_path() {
  FLAVOR=$1

  if [ -f "bin/.tmp/private_keys/android_keystores/${FLAVOR}_debug.keystore" ]; then
    echo "../../bin/.tmp/private_keys/android_keystores/${FLAVOR}_debug.keystore"
  fi
}
